# =========================================================================
# .env.example — TEMPLATE (safe to commit). Copy to .env and fill real values.
#   cp .env.example .env
# The real .env is gitignored so secrets never reach GitHub.
# =========================================================================

# --- Stock API ---
ALPHA_VANTAGE_API_KEY=your_key_here
# Comma-separated list of ticker symbols to track
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN
# How often to poll each ticker, in seconds
POLL_INTERVAL_SECONDS=60

# --- Kafka (used in Phase 2-3) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=stock-prices

# --- MinIO (object storage: Bronze/Silver/Gold layers) ---
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password_min_8_chars

# --- Application ---
LOG_LEVEL=INFO
